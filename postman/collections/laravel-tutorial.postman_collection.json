    "event": [
        {
            "listen": "prerequest",
            "script": {
                "type": "text/javascript",
                "exec": [
                    "// POST/PATCH/PUT/DELETE の前に CSRF トークンを取得して X-XSRF-TOKEN ヘッダーへ設定する",
                    "const method = pm.request.method.toUpperCase();",
                    "",
                    "if (['POST', 'PATCH', 'PUT', 'DELETE'].includes(method)) {",
                    "    const baseUrl = pm.collectionVariables.get('BASE_URL');",
                    "",
                    "    if (!baseUrl) {",
                    "        console.error('BASE_URL が未定義です。コレクション変数を確認してください。');",
                    "    } else {",
                    "        pm.sendRequest({ url: baseUrl + '/sanctum/csrf-cookie', method: 'GET' }, function (err, res, cookies) {",
                    "            if (err) {",
                    "                console.error('/sanctum/csrf-cookie に到達できません:', err.message);",
                    "",
                    "                return;",
                    "            }",
                    "",
                    "            if (res.code >= 400) {",
                    "                console.error('/sanctum/csrf-cookie が ' + res.code + ' を返しました。BASE_URL とサーバーを確認してください。');",
                    "",
                    "                return;",
                    "            }",
                    "",
                    "            const rawToken = readCookie(cookies, 'XSRF-TOKEN')",
                    "                || readCookie(res.cookies, 'XSRF-TOKEN')",
                    "                || readCookieFromHeaders(res, 'XSRF-TOKEN');",
                    "",
                    "            if (!rawToken) {",
                    "                console.error('XSRF-TOKEN クッキーが見つかりませんでした。');",
                    "",
                    "                return;",
                    "            }",
                    "",
                    "            const token = decodeURIComponent(rawToken);",
                    "",
                    "            // 無効化された既存行が残っていると upsert では送信されないため、削除してから追加する",
                    "            pm.request.headers.remove('X-XSRF-TOKEN');",
                    "            pm.request.headers.add({ key: 'X-XSRF-TOKEN', value: token });",
                    "            pm.collectionVariables.set('XSRF-TOKEN', token);",
                    "        });",
                    "    }",
                    "}",
                    "",
                    "function readCookie(cookieList, name) {",
                    "    if (!cookieList || typeof cookieList.one !== 'function') {",
                    "        return null;",
                    "    }",
                    "",
                    "    const cookie = cookieList.one(name);",
                    "",
                    "    return cookie ? cookie.value : null;",
                    "}",
                    "",
                    "function readCookieFromHeaders(res, name) {",
                    "    const header = res.headers.all().find(function (h) {",
                    "        return h.key.toLowerCase() === 'set-cookie' && h.value.indexOf(name + '=') === 0;",
                    "    });",
                    "",
                    "    return header ? header.value.split(';')[0].split('=')[1] : null;",
                    "}"
                ]
            }
        }
    ],
